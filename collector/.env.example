# Accounts used by `python run.py all <task>` (platform:account, comma separated)
ACCOUNTS=zomato:main,swiggy:mn,swiggy:ggn,google:agency

# Codeonto database: the collector writes outlet catalogs and account sync times here
CODEONTO_DATABASE_URL=postgresql://akashchauhan@localhost:5432/codeonto_app

# Where session files are written (default: ./sessions). Codeonto platform accounts point here.
SESSIONS_DIR=

# --- Zomato (email OTP). Account "main" -> ZOMATO_MAIN_* ---
ZOMATO_MAIN_EMAIL=
ZOMATO_MAIN_IMAP_PASSWORD=
ZOMATO_IMAP_HOST=imap.secureserver.net
ZOMATO_IMAP_PORT=993

# --- Swiggy (phone + password). Account "mn" -> SWIGGY_MN_*, "ggn" -> SWIGGY_GGN_* ---
SWIGGY_MN_PHONE=
SWIGGY_MN_PASSWORD=
SWIGGY_GGN_PHONE=
SWIGGY_GGN_PASSWORD=

# --- Google Business Profile (OAuth). One-time browser login per account: run.py google session --account agency ---
# Path to the OAuth client JSON (client_secret_….apps.googleusercontent.com.json) from Google Cloud Console
GOOGLE_OAUTH_CLIENT_FILE=

# --- Optional: push refreshed sessions to the central server (skipped if URL or secret empty) ---
ZOMATO_PUSH_URL=
SWIGGY_PUSH_URL=
COOKIE_PUSH_SECRET=

# --- Alerts (stock-outs, collector problems). Recipients per client are set in admin → Alert recipients ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BEARER_TOKEN=
WHATSAPP_OOS_TEMPLATE=
# Who hears about collector problems (expired session etc.), comma separated
ALERT_OPS_EMAILS=

# ===== Tunables (all optional; the value shown is the default) =====
# Shared
# HTTP_TIMEOUT_SEC=30
# RETRY_WAITS=0.5,15,45,90        # seconds to wait before each attempt; a 429/5xx moves to the next wait
# HTTP_USER_AGENT=
# TIMEZONE_OFFSET_MINUTES=330     # IST
# SENTIMENT_POSITIVE_MIN=4        # stars at or above = positive
# SENTIMENT_NEUTRAL_MIN=3         # stars at or above = neutral, below = negative
# Zomato
# ZOMATO_API_BASE=https://api.zomato.com/merchant-gw/web
# ZOMATO_ORIGIN=https://www.zomato.com
# ZOMATO_CLIENT_ID=zomato_web_merchant
# ZOMATO_REVIEW_PAGES=10          # pages of reviews per store per run
# ZOMATO_REVIEW_PAGE_SIZE=5
# ZOMATO_REPORT_DAYS=10           # business report window in days (fetched in chunks of ZOMATO_REPORT_CHUNK_DAYS)
# ONLY_RES_IDS=                   # comma separated Zomato ids: limit business report to these stores
# STOCKOUT_WORKERS=3              # stores fetched in parallel
# STOCKOUT_PACE_SEC=0.8,1.8       # random wait range before each stock-out request
# Swiggy
# SWIGGY_REVIEW_DAYS=60
# SWIGGY_REVIEW_PAGE_SIZE=1000
# Google
# GOOGLE_REVIEW_PAGES=10
# GOOGLE_REVIEW_PAGE_SIZE=50
# GOOGLE_METRICS_DAYS=30
# GOOGLE_METRICS_LAG_DAYS=2       # newest days Google has not published yet
# Alerts
# INCIDENT_COOLDOWN_SEC=3600      # same collector problem is emailed at most once per this many seconds
# WHATSAPP_TEMPLATE_LANG=en
# Label maps, scoring checks and meal windows live in collector/mappings/*.json

# --- Clients who connected Google through the dashboard ("Connect with Google") ---
# Same values as the project's main .env: the web OAuth client and the key that decrypts stored tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
