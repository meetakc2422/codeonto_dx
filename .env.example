DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://akashchauhan@localhost:5432/codeonto_app

# Read-only pipeline DB used by scripts/import_pipeline_outlets.py
PIPELINE_DATABASE_URL=postgresql://akashchauhan@localhost:5432/dashboard_v1

# Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
# Browser key for the competition map (Maps JavaScript API, restricted to your domains)
GOOGLE_MAPS_BROWSER_KEY=

# Zomato
ZOMATO_BASE_URL=https://api.zomato.com/merchant-gw/web
# Cookie file kept fresh by the pipeline's zomato_refresh_session.py (default session for all Zomato listings)
ZOMATO_COOKIE_FILE=/path/to/restaurant-data-pipeline/scraping/zomato_cookies.json
# per-brand session JSON, referenced as credentials_ref = env:ZOMATO_SESSION_<BRAND>
# ZOMATO_SESSION_BRAND1={"cookie": "...", "csrf_token": "...", "mx_csrf_token": "..."}

# Swiggy session file kept fresh by the pipeline's swiggy_refresh_token_mn.py
SWIGGY_SESSION_FILE=/path/to/restaurant-data-pipeline/scraping/swiggy_session_mn.json
SWIGGY_BASE_URL=
SWIGGY_API_KEY=

# AI replies
ANTHROPIC_API_KEY=

# --- Emails (dashboard alerts, password resets); leave empty to print them to the console ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# sender address (needed with Amazon SES, whose SMTP user is an access key)
EMAIL_FROM=
# The dashboard's public address, used in password reset links, e.g. https://app.codeonto.com
DASHBOARD_URL=

# Google OAuth web client for "Connect Google" (client onboarding)
GOOGLE_OAUTH_REDIRECT_URI=
# Key that encrypts clients' stored Google tokens (same value in .env and collector/.env). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=

# Windows menu proxy for Zomato competitor menus (EC2 IPs are blocked on /gw/menu)
# ZOMATO_MENU_PROXY_URL=http://<windows-server-ip>:5000
